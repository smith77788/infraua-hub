# Звʼязок консолі InfraUA з аналітичною платформою (Palanter на Railway).
#
# Це ПРИКЛАД. Реальні значення задаються в дашбордах, а не в git:
#   • консоль (Lovable / Cloudflare)  — PLATFORM_API_URL, PLATFORM_API_KEY
#   • платформа (Railway)             — PLATFORM_API_KEYS
# Секрети НЕ комітяться в репозиторій.
#
# Без цих змінних консоль повністю працює сама — розділи платформи просто
# ховаються (configured:false — це штатний стан, а не помилка).

# ── Консоль (Lovable / Cloudflare Workers) ─────────────────────────────────
# Публічний домен сервісу платформи на Railway.
PLATFORM_API_URL=https://<ваш-сервіс>.up.railway.app
# Bearer-ключ. МАЄ збігатися з одним із ключів у PLATFORM_API_KEYS на Railway.
PLATFORM_API_KEY=<той самий ключ, що й на платформі>

# ── Платформа (Railway) ────────────────────────────────────────────────────
# JSON-мапа «ключ → рівень доступу». Коротка форма (рівень рядком) — правильна
# для службового ключа консолі. Рівень визначає, що консоль бачить у графі.
# PLATFORM_API_KEYS={"<той самий ключ>":"SECRET"}
#
# Стан платформи (граф, аудит, справи) лежить на постійному томі Railway:
# PLATFORM_DATA_DIR=/data

# ── Шари критичної інфраструктури ──────────────────────────────────────────
# Вимикач із двох частин. Шари віддаються, лише коли обидві кажуть «так»;
# вимкнути можна будь-якою з них незалежно.
#
# 1) ДОЗВІЛ — ця змінна. Задається в дашбордах (консоль і платформа окремо),
#    і жодна команда ззовні її не змінить. Єдине значення, що вмикає, — `on`.
#    Без неї шарів немає ніколи.
# INFRA_LAYERS=on
#
# 2) РУЧКА — перемикач, збережений на диску платформи. Крутиться з бота
#    (`/layers on` · `/layers off`) або через API платформи, переживає
#    рестарт, кожен оберт лягає в журнал аудиту. Усталене — вимкнено.
#
# Недоступна платформа означає для консолі «вимкнено»: вимикач, який може
# заклинити в положенні «увімкнено», гірший за його відсутність.

# ── Власник розгортання (адмінкоманди бота) ────────────────────────────────
# Числовий Telegram-ID того, кому дозволені /layers і /purge. Поки не заданий,
# адмінкоманд немає НІ В КОГО — усталене значення відкритого доступу в
# елементі контролю доступу було б дірою, а не зручністю.
# Не комітиться: це персональні дані й водночас елемент контролю доступу.
# TELEGRAM_OWNER_ID=<ваш числовий id>
