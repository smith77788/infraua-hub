# Звʼязок консолі InfraUA з аналітичною платформою (Palanter на Railway).
#
# Це ПРИКЛАД. Реальні значення задаються в дашбордах, а не в git:
#   • консоль (Lovable / Cloudflare)  — PLATFORM_API_URL, PLATFORM_API_KEY
#   • платформа (Railway)             — PLATFORM_API_KEYS
# Секрети НЕ комітяться в репозиторій.
#
# Без цих змінних консоль повністю працює сама — розділи платформи просто
# ховаються (configured:false — це штатний стан, а не помилка).

# ── Консоль (Lovable / Cloudflare Workers) ─────────────────────────────────
# Публічний домен сервісу платформи на Railway.
PLATFORM_API_URL=https://<ваш-сервіс>.up.railway.app
# Bearer-ключ. МАЄ збігатися з одним із ключів у PLATFORM_API_KEYS на Railway.
PLATFORM_API_KEY=<той самий ключ, що й на платформі>

# ── Платформа (Railway) ────────────────────────────────────────────────────
# JSON-мапа «ключ → рівень доступу». Коротка форма (рівень рядком) — правильна
# для службового ключа консолі. Рівень визначає, що консоль бачить у графі.
# PLATFORM_API_KEYS={"<той самий ключ>":"SECRET"}
#
# Стан платформи (граф, аудит, справи) лежить на постійному томі Railway:
# PLATFORM_DATA_DIR=/data

# ── Шари критичної інфраструктури ──────────────────────────────────────────
# Вимикач із двох частин. Шари віддаються, лише коли обидві кажуть «так»;
# вимкнути можна будь-якою з них незалежно.
#
# 1) ДОЗВІЛ — ця змінна. Задається в дашбордах (консоль і платформа окремо),
#    і жодна команда ззовні її не змінить. Єдине значення, що вмикає, — `on`.
#    Без неї шарів немає ніколи.
# INFRA_LAYERS=on
#
# 2) РУЧКА — перемикач, збережений на диску платформи. Крутиться з бота
#    (`/layers on` · `/layers off`) або через API платформи, переживає
#    рестарт, кожен оберт лягає в журнал аудиту. Усталене — вимкнено.
#
# Недоступна платформа означає для консолі «вимкнено»: вимикач, який може
# заклинити в положенні «увімкнено», гірший за його відсутність.

# ── Власник розгортання (адмінкоманди бота) ────────────────────────────────
# Числовий Telegram-ID того, кому дозволені /layers і /purge. Поки не заданий,
# адмінкоманд немає НІ В КОГО — усталене значення відкритого доступу в
# елементі контролю доступу було б дірою, а не зручністю.
# Не комітиться: це персональні дані й водночас елемент контролю доступу.
# TELEGRAM_OWNER_ID=<ваш числовий id>

# Який репозиторій питати про стан конвеєра (чи доїжджає код до людей).
# На Railway не потрібно: RAILWAY_GIT_REPO_OWNER і RAILWAY_GIT_REPO_NAME
# підставляються самі. Без жодного з них перевірка чесно скаже «невідомо»,
# а не «усе гаразд».
# GITHUB_REPO=smith77788/infraua-hub

# ── Автоканал: ІІ веде Telegram-канал повітряної обстановки ────────────────
# Куди постити зведення (стиль народних моніторів): @username каналу, куди
# бота додано АДМІНОМ із правом публікації, або числовий id виду -100…
# Порожнє — автоканал вимкнено (маршрут tick відповість «не заданий»).
# TELEGRAM_CHANNEL_ID=@your_channel
#
# Пост не шлеться сам: його «смикає» зовнішній планувальник кожні кілька
# хвилин запитом (той самий TELEGRAM_WEBHOOK_SECRET боронить маршрут):
#   GET https://<домен>/api/telegram/channel/tick?secret=<TELEGRAM_WEBHOOK_SECRET>
# Дедуп і мінімальний інтервал (4 хв) — усередині: той самий пост двічі не
# піде. Перевірити без надсилання: додати &dry=1 — поверне текст, не постячи.

# ── Персональний радар у боті ──────────────────────────────────────────────
# Імʼя бота в Telegram — потрібне для посилань-запрошень (`t.me/<імʼя>?start=…`)
# і для кнопки під постами каналу. Якщо не задано, бот дізнається його сам
# через getMe; змінна потрібна лише там, де вихід до api.telegram.org закритий.
# TELEGRAM_BOT_USERNAME=Radar_UAbot
#
# Де лежать підписки. БЕЗ ПОСТІЙНОГО ТОМУ ПІДПИСНИКИ ЗНИКАЮТЬ ПРИ РЕДЕПЛОЇ —
# файл ляже в ефемерну файлову систему контейнера.
#
# НА RAILWAY ЦЮ ЗМІННУ ЗАДАВАТИ НЕ ТРЕБА. Достатньо підключити том до сервісу
# консолі (Service → Volumes → + New Volume, шлях монтування /data). Railway
# сам виставляє RAILWAY_VOLUME_MOUNT_PATH, і бот його підхоплює.
#
# Задавайте BOT_DATA_DIR лише тоді, коли том ділять із чимось іще й підпискам
# потрібна окрема тека всередині нього.
# BOT_DATA_DIR=/data
#
# Перевірка: `/stats` у боті показує шлях, ЗВІДКИ він узявся, і результат
# справжньої спроби запису — а не висновок із наявності змінної.
#
# Публічна адреса карти для кнопки «🗺 Карта» під постами каналу. Якщо не
# задано, береться TELEGRAM_WEBHOOK_HOST; немає й того — кнопки просто не буде.
# PUBLIC_SITE_URL=https://<ваш-домен>
#
# ⚠️ Inline-режим (бот у чужих чатах: «@Radar_UAbot Харків») вмикається ТІЛЬКИ
# в @BotFather: /setinline → обрати бота → підказка для поля вводу. Код це
# зробити не може — Bot API не дає такого методу. Поки не увімкнено, Telegram
# просто не надсилає оновлень inline_query, і бот про це не дізнається.

# ── Англомовний дзеркальний канал ──────────────────────────────────────────
# Той самий пост, складений заново англійською з ТИХ САМИХ чисел (не переклад).
# Аудиторія поза країною: кореспонденти, аналітики, діаспора. Порожнє — дзеркала
# немає (штатний стан).
# TELEGRAM_CHANNEL_ID_EN=@your_channel_en

# ── Гейт підписки на канал ─────────────────────────────────────────────────
# Вмикається САМ, щойно TELEGRAM_CHANNEL_ID заданий у вигляді @username (з
# числового id гейт неможливий: ми не можемо показати людині, КУДИ підписатись,
# тож у цьому разі радар лишається відкритим).
#
# ⚠️ Бот МАЄ бути адміністратором каналу — інакше getChatMember не відповідає.
# Він і так має ним бути, щоб постити.
#
# Гейт навмисно відмовляє У БІК ДОСТУПУ: не вдалося перевірити членство —
# пускаємо. Це інструмент безпеки, і збій на нашому боці не має коштувати
# комусь сповіщення про ціль. З тієї ж причини поза гейтом лишаються /stop,
# /help, /status і пауза сповіщень.
