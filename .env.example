# Звʼязок консолі InfraUA з аналітичною платформою (Palanter на Railway).
#
# Це ПРИКЛАД. Реальні значення задаються в дашбордах, а не в git:
#   • консоль (Lovable / Cloudflare)  — PLATFORM_API_URL, PLATFORM_API_KEY
#   • платформа (Railway)             — PLATFORM_API_KEYS
# Секрети НЕ комітяться в репозиторій.
#
# Без цих змінних консоль повністю працює сама — розділи платформи просто
# ховаються (configured:false — це штатний стан, а не помилка).

# ── Консоль (Lovable / Cloudflare Workers) ─────────────────────────────────
# Публічний домен сервісу платформи на Railway.
PLATFORM_API_URL=https://<ваш-сервіс>.up.railway.app
# Bearer-ключ. МАЄ збігатися з одним із ключів у PLATFORM_API_KEYS на Railway.
PLATFORM_API_KEY=<той самий ключ, що й на платформі>

# ── Платформа (Railway) ────────────────────────────────────────────────────
# JSON-мапа «ключ → рівень доступу». Коротка форма (рівень рядком) — правильна
# для службового ключа консолі. Рівень визначає, що консоль бачить у графі.
# PLATFORM_API_KEYS={"<той самий ключ>":"SECRET"}
#
# Стан платформи (граф, аудит, справи) лежить на постійному томі Railway:
# PLATFORM_DATA_DIR=/data
