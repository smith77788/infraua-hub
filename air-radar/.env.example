# ── Telegram (живий інжест сирих повідомлень; опційно) ──────────────────
# HUMAN ACTION: отримайте api_id / api_hash на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Назва файл-сесії або StringSession (якщо довша за 40 символів — трактується як StringSession)
TG_SESSION=air_radar
# Публічні канали моніторингу (через кому, без @)
TG_CHANNELS=war_monitor,napramok,monitor_war

# ── Bridge реального OSINT-джерела (detoyshahed.in.ua) ──────────────────
# Дає живі дані навіть без ключів Telegram. 1 = увімкнено.
ENABLE_BRIDGE=1
BRIDGE_POLL_SECONDS=20

# ── Сервер ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
