# Образ API платформи.
#
# Консоль сюди НЕ збирається: вона розгортається окремим сервісом із того ж
# репозиторію. Платформа лишається чистим API — так її і тестують.
#
# Збірка йде з кореня репозиторію, бо залежності оголошені в кореневому
# package.json: платформа переїхала сюди з окремого репозиторію і тепер живе
# під platform/.

FROM node:20-alpine AS build
WORKDIR /app

# Лише залежності платформи, з версіями з кореневого package.json
# (`platform/deps.mjs` — там і чому). Раніше образ ставив усе дерево консолі,
# ~360 пакетів, і збірка 20.10.2026 впала саме на install цього дерева.
COPY package.json ./
COPY platform/deps.mjs ./platform/deps.mjs
RUN node platform/deps.mjs build > deps.json && mv deps.json package.json \
 && npm install --no-audit --no-fund --ignore-scripts

COPY platform ./platform
RUN node platform/build.mjs

FROM node:20-alpine AS runtime
WORKDIR /app

# Саме цей крок упав 20.10 («[runtime 4/6] RUN npm install --omit=dev»):
# тепер тут чотири пакети платформи без dev-частини, тож `--omit=dev` не
# потрібен, а NODE_ENV виставляється вже після install.
COPY package.json ./
COPY platform/deps.mjs ./platform/deps.mjs
RUN node platform/deps.mjs runtime > deps.json && mv deps.json package.json \
 && npm install --no-audit --no-fund --ignore-scripts
ENV NODE_ENV=production

COPY --from=build /app/platform/dist ./platform/dist
# Конфігурація читається у рантаймі: онтологія та політики безпеки — це
# налаштування оператора, а не константи в коді.
COPY platform/config ./platform/config

# Стан платформи (граф, аудит, справи) має пережити перезапуск контейнера.
#
# Директиви монтування тому тут немає навмисно: Railway її не приймає й
# відхиляє збірку цілком, вимагаючи натомість власні томи. Том створено на
# боці Railway і змонтовано в цей самий шлях.
ENV PLATFORM_DATA_DIR=/data

EXPOSE 4500
CMD ["node", "platform/dist/api/server.js"]
